[Unit]
Description=Collect watched pull requests
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/data-collect-proc/source
ExecStart=/opt/data-collect-proc/source/tasks/github-work-watch/deploy/run.sh
TimeoutStartSec=25min
