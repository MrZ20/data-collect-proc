[Unit]
Description=Check vLLM Ascend monitored files
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/data-collect-proc/source
ExecStart=/opt/data-collect-proc/source/tasks/vllm-ascend-changes/deploy/run.sh
TimeoutStartSec=12min
